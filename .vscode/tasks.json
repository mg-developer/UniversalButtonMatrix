{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake configure host",
      "type": "shell",
      "command": "cmake -S . -B build -DHOST_BUILD=ON -DCONSOLE_DEBUG=2 -DVARIANT_128_BUTTONS_ENABLED=ON",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build host",
      "type": "shell",
      "command": "cmake --build build --target UniversalButtonMatrix_host --config Debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["cmake configure host"],
      "problemMatcher": []
    }
  ]
}
