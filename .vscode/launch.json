{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch UniversalButtonMatrix_host (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/UniversalButtonMatrix_host.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build host",
      "console": "externalConsole"
    },
    {
      "name": "Launch UniversalButtonMatrix_host (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/UniversalButtonMatrix_host.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build host",
      "miDebuggerPath": "gdb.exe",
      "externalConsole": true,
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
